          "S1|2026-05-06": { "required": 1, "counted": 0, "covered": 0, "open": 1, "surplus": 0 },
          "S2|2026-05-06": { "required": 1, "counted": 1, "open": 0 },
          "S3|2026-05-06": { "required": 1, "counted": 1, "locum": 1, "covered": 2, "open": 0, "surplus": 1 },
          "S1|2026-05-07": { "required": 1, "counted": 0, "acceptedShort": 1, "covered": 0, "open": 0, "surplus": 0 },
          "S2|2026-05-07": { "required": 1, "counted": 1, "open": 0, "surplus": 0 },
          "S1|2026-05-08": { "required": 1, "counted": 1, "open": 0 },
          "S2|2026-05-08": { "required": 2, "counted": 1, "open": 1, "surplus": 0 },
          "S3|2026-05-08": { "required": 1, "counted": 1, "open": 0 }
        }
      }
