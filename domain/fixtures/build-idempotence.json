{
  "name": "build idempotence; pattern-blocked vs exception gaps in the report",
  "covers": ["build", "idempotence", "patternCannotApply", "exceptionsCreatedGaps", "availability"],
  "asOf": "2026-05-01",
  "seed": {
    "stores": [
      { "id": "S1", "closedWeekdays": [0, 2, 3, 4, 5, 6] },
      { "id": "S2", "closedWeekdays": [0, 1, 3, 4, 5, 6] }
    ],
    "pharmacists": [
      { "id": "P1", "base": "S1" },
      { "id": "P2", "base": "S2" }
    ],
    "standing": [
      { "id": "T1", "store": "S1", "ph": "P1", "from": "2026-04-01", "recurrence": { "weekdays": [1], "cycleWeeks": 1, "anchor": "2026-05-04" } },
      { "id": "T2", "store": "S2", "ph": "P2", "from": "2026-04-01", "recurrence": { "weekdays": [2], "cycleWeeks": 1, "anchor": "2026-05-05" } }
    ],
    "unavailability": [
      { "id": "U1", "ph": "P1", "first": "2026-05-11", "last": "2026-05-11", "status": "Approved", "type": "Vacation" }
    ]
  },
  "steps": [
    {
      "op": "build",
      "range": { "from": "2026-05-01", "to": "2026-05-31" },
      "accept": true,
      "why": "S1 is open Mondays only (05-04, 11, 18, 25); S2 Tuesdays only (05-05, 12, 19, 26). P1's Monday 05-11 is blocked by an Approved vacation (availability is a presence rule), so 3 + 4 = 7 placements. P2 is not assigned on 05-11, and off-duty pharmacists are only used by Search Wider, so the S1 gap stays unresolved. AMBIGUITY (spec 9.1 vs BuildReport comment): 9.1 says a blocked pattern assignment counts under patternCannotApply and, if it leaves the cell short, also under exceptionsCreatedGaps; this fixture follows 9.1 literally.",
      "expect": {
        "hasProposal": true,
        "edits": { "$count": 7 },
        "report": {
          "edits": 7,
          "instantiated": 7,
          "patternCannotApply": [{ "storeId": "S1", "pharmacistId": "P1", "date": "2026-05-11", "why": { "$any": true } }],
          "exceptionsCreatedGaps": [{ "storeId": "S1", "date": "2026-05-11" }],
          "patternConflicts": [],
          "unresolvedGaps": [{ "storeId": "S1", "date": "2026-05-11" }]
        }
      }
    },
    {
      "op": "evaluate",
      "range": { "from": "2026-05-01", "to": "2026-05-31" },
      "expect": {
        "cells": {
          "S1|2026-05-04": { "required": 1, "counted": 1, "open": 0 },
          "S1|2026-05-11": { "required": 1, "counted": 0, "open": 1 },
          "S1|2026-05-18": { "required": 1, "counted": 1, "open": 0 },
          "S1|2026-05-25": { "required": 1, "counted": 1, "open": 0 },
          "S2|2026-05-05": { "required": 1, "counted": 1, "open": 0 },
          "S2|2026-05-12": { "required": 1, "counted": 1, "open": 0 },
          "S2|2026-05-19": { "required": 1, "counted": 1, "open": 0 },
          "S2|2026-05-26": { "required": 1, "counted": 1, "open": 0 }
        },
        "assignments": { "S1|P1|2026-05-11": { "$absent": true } }
      }
    },
    {
      "op": "build",
      "range": { "from": "2026-05-01", "to": "2026-05-31" },
      "accept": true,
      "why": "Same inputs, dates now built: no proposal, no edits. Unresolvable gap stays listed, not retried into a different answer (spec 9.4).",
      "expect": {
        "hasProposal": false,
        "edits": [],
        "report": { "edits": 0, "instantiated": 0, "patternConflicts": [], "unresolvedGaps": [{ "storeId": "S1", "date": "2026-05-11" }] }
      }
    },
    {
      "op": "build",
      "range": { "from": "2026-05-01", "to": "2026-05-31" },
      "accept": true,
      "why": "A third run is still a no-op.",
      "expect": { "hasProposal": false, "edits": [] }
    },
    {
      "op": "evaluate",
      "range": { "from": "2026-05-01", "to": "2026-05-31" },
      "why": "State unchanged by the no-op builds.",
      "expect": { "cells": { "S1|2026-05-11": { "open": 1 }, "S1|2026-05-04": { "counted": 1 } } }
    }
  ]
}
