{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": ["harness/stubs/utils.ts"],
      "@/lib/auth/provider": ["harness/stubs/auth/provider.tsx"],
      "@/lib/error-component": ["harness/stubs/error-component.tsx"],
      "@/lib/preview-host-bridge": ["harness/stubs/preview-host-bridge.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "harness"]
}
