{
  "name": "hischool-scheduler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev -c vite.spa.config.ts --host 0.0.0.0 --port 3000",
    "build": "vite build -c vite.spa.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run test:schedule",
    "test:schedule": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/schedule/*.test.ts src/store/schedule-store.test.ts",
    "build:trial": "vite build -c vite.spa.config.ts",
    "build:real": "vite build -c vite.spa.config.ts --mode real",
    "e2e": "node e2e/run.mjs",
    "e2e:real": "node e2e/real-build.mjs",
    "all": "node scripts/all.mjs",
    "sweep": "node scripts/sweep.mjs",
    "screens": "node scripts/screens.mjs",
    "deep": "node scripts/all.mjs --deep",
    "guards": "node scripts/guards.mjs",
    "real": "node scripts/with-server.mjs real node e2e/real-build.mjs",
    "stress": "node scripts/with-server.mjs trial node stress/monkey.mjs",
    "lint": "eslint src",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
